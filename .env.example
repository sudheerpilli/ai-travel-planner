# TripWise 2.0 — Environment Configuration
# Copy this file to .env and configure any optional keys as desired.
# NOTE: All features work 100% out of the box with zero keys required!

# Flask Debug Mode (1 = enabled, 0 = disabled)
FLASK_DEBUG=0

# Optional: Google Maps API Key
# Used for Google Geocoding, Google Directions, and Google Places.
# If omitted, TripWise uses free OpenStreetMap Nominatim and OSRM road routing.
GOOGLE_MAPS_API_KEY=

# Optional: AI Chatbot LLM Keys (Gemini or OpenAI)
# Used for live LLM responses in the AI Travel Assistant.
# If omitted, TripWise uses its built-in expert travel intelligence knowledge engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=

# Optional: OpenWeatherMap API Key
# If omitted, TripWise uses Open-Meteo API (100% free, real-time forecasts, no key needed).
OPENWEATHERMAP_API_KEY=

# Optional: Local Ollama LLM (zero cloud costs, runs entirely on your machine)
# Install Ollama from https://ollama.ai and run: ollama pull mistral:7b
# Then set OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=mistral:7b
