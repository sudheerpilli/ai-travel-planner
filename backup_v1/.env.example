# TripWise — Environment Configuration
# Copy this file to .env and fill in your values.

# Flask settings
FLASK_DEBUG=0

# Optional: OpenRouteService API key for enhanced routing
# Get a free key at https://openrouteservice.org/dev/#/signup
# If not set, the app uses the free public OSRM router instead.
ORS_API_KEY=

# Optional: Exchange rate API key
# The app uses https://api.exchangerate-api.com/v4/latest/INR (free, no key required).
# A key is not needed for basic usage.
EXCHANGE_API_KEY=
